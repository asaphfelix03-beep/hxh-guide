@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Text.Title;
}

<div class="error-page">
    <partial name="_NenGlass" model="(NenType?)null" />
    <h1 class="display-title h2 mt-3">@Model.Text.Title</h1>
    <p class="text-body-secondary">@Model.Text.Message</p>
    <a class="btn btn-primary" href="/">Retour à l'accueil</a>
</div>
