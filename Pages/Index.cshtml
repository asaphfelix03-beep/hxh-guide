@page
@model IndexModel
@{
    ViewData["Title"] = Model.State.SignedIn ? "Ma lecture" : "Le guide du manga";
    var state = Model.State;
    var best = Model.Ratings.Values.Where(r => r.Count > 0).OrderByDescending(r => r.Average).ThenByDescending(r => r.Count).FirstOrDefault();
}

@if (!state.SignedIn)
{
    <section class="hero">
        <div class="hero-text">
            <h1 class="display-title">Hunter × Hunter, tome après tome.</h1>
            <p class="lead">
                Le guide des huit arcs du manga, de ses personnages et du Nen. Coche les tomes que tu as lus :
                tout ce qui vient après reste masqué, pour lire sans te faire spoiler.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="/Compte/Inscription">Commencer mon classeur</a>
                <a class="btn btn-outline-secondary btn-lg" href="/Arcs">Parcourir les arcs</a>
            </div>
            @if (Model.DemoEnabled)
            {
                <p class="demo-hint mt-4 mb-0">
                    Envie d'essayer d'abord ? Compte de démonstration :
                    <code>@SeedData.DemoEmail</code> / <code>@SeedData.DemoPassword</code>
                </p>
            }
        </div>
        <div class="hero-binder" aria-hidden="true">
            @for (var n = 1; n <= 12; n++)
            {
                var arc = Catalog.MainArcOfVolume(n);
                <span class="slot arc-@arc.Slug @(n <= 7 ? "is-read" : "")"><span class="slot-number">@n</span></span>
            }
        </div>
    </section>

    <section class="mt-5">
        <h2 class="h4 mb-3">Les huit arcs</h2>
        <partial name="_ArcTimeline" model="state" />
        @if (best is not null && Catalog.ArcBySlug(best.ArcSlug) is { } bestArc)
        {
            <p class="text-body-secondary mt-3 mb-0">
                L'arc préféré des lecteurs : <a href="/Arcs/@bestArc.Slug">@bestArc.Title</a>,
                noté @best.Average.ToString("0.0") sur 5 (@best.Count avis).
            </p>
        }
    </section>
    @if (Model.ReaderCount > 0)
    {
        <p class="text-body-secondary small mt-4">@Model.ReaderCount lecteurs suivent déjà leur lecture ici.</p>
    }
    return;
}

<div class="dashboard">
    <section>
        <h1 class="display-title h2 mb-1">Bonjour, @User.DisplayName()</h1>
        @if (state.NextVolume is { } next && state.CurrentArc is { } current)
        {
            <p class="lead mb-4">Prochain tome à lire : <strong>tome @next</strong>, dans « <a href="/Arcs/@current.Slug">@current.Title</a> ».</p>
        }
        else
        {
            <p class="lead mb-4">Tu as lu les @Catalog.TotalVolumes tomes parus. Il ne reste plus qu'à attendre le prochain.</p>
        }

        <div class="progress-block">
            <div class="d-flex justify-content-between align-items-baseline">
                <span class="big-number">@state.ReadCount<small>/@Catalog.TotalVolumes</small></span>
                <span class="text-body-secondary">@state.Percent % du manga lu</span>
            </div>
            <div class="meter meter-lg" role="progressbar" aria-label="Tomes lus" aria-valuenow="@state.Percent" aria-valuemin="0" aria-valuemax="100">
                <span style="width: @state.Percent%"></span>
            </div>
        </div>

        <h2 class="h5 mt-4 mb-3">Ma progression par arc</h2>
        <partial name="_ArcTimeline" model="state" />

        <div class="d-flex align-items-center justify-content-between mt-5 mb-3">
            <h2 class="h5 mb-0">Mon classeur</h2>
            <a class="btn btn-sm btn-outline-secondary" href="/Classeur">Mettre à jour</a>
        </div>
        <partial name="_Binder" model="new BinderModel(state, Interactive: false, Compact: true)" />
    </section>

    <aside>
        <h2 class="h5 mb-3">Mes personnages favoris</h2>
        @if (Model.Favorites.Count == 0)
        {
            <div class="empty-state">
                <icon name="heart" />
                <p class="mb-2">Aucun favori pour l'instant.</p>
                <a class="btn btn-sm btn-outline-secondary" href="/Personnages">Voir les personnages</a>
            </div>
        }
        else
        {
            <ul class="favorite-list">
                @foreach (var character in Model.Favorites)
                {
                    <li>
                        <a href="/Personnages/@character.Slug">
                            <portrait character="@character" />
                            <span class="min-w-0">
                                <span class="d-block fw-semibold text-truncate">@character.Name</span>
                                <span class="small text-body-secondary">@character.Affiliation</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }

        @if (state.HideSpoilers)
        {
            <p class="spoiler-note"><icon name="eye-slash" /> Mode sans spoiler activé : le contenu des arcs après le tome @state.MaxRead est masqué.</p>
        }
    </aside>
</div>
