@page
@model HxhGuide.Pages.Personnages.IndexModel
@{
    ViewData["Title"] = "Personnages";
    var nenOptions = NenTypes.All.Select(n => new SelectListItem(n.Name, n.Type.ToString(), n.Type == Model.Nen));
    var arcOptions = Catalog.Arcs.Select(a => new SelectListItem(a.Title, a.Slug, a.Slug == Model.ArcSlug));
}

<h1 class="display-title h2 mb-1">Personnages</h1>
<p class="text-body-secondary mb-4">
    @Catalog.Characters.Count personnages principaux, avec leur type de Nen quand le manga le précise.
    @if (Model.State.SignedIn && Model.State.HideSpoilers)
    {
        <span>Ceux des arcs que tu n'as pas encore atteints sont masqués.</span>
    }
</p>

<form method="get" class="filters">
    <select name="nen" class="form-select form-select-sm" aria-label="Filtrer par type de Nen" onchange="this.form.requestSubmit()">
        <option value="">Tous les types de Nen</option>
        @foreach (var option in nenOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
    <select name="arc" class="form-select form-select-sm" aria-label="Filtrer par arc d'apparition" onchange="this.form.requestSubmit()">
        <option value="">Tous les arcs</option>
        @foreach (var option in arcOptions)
        {
            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
        }
    </select>
    @if (Model.State.SignedIn)
    {
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="favoris" name="favoris" value="true" checked="@Model.OnlyFavorites" onchange="this.form.requestSubmit()" />
            <label class="form-check-label small" for="favoris">Mes favoris</label>
        </div>
    }
    <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Filtrer</button></noscript>
</form>

@if (Model.Cards.Count == 0)
{
    <div class="empty-state">
        <icon name="people" />
        <p class="mb-0">Aucun personnage ne correspond à ces filtres.</p>
    </div>
}
else
{
    <div class="character-grid">
        @foreach (var card in Model.Cards)
        {
            <partial name="_CharacterCard" model="card" />
        }
    </div>
}
