@page
@model TaskFlow.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Projets";
}

<div class="row g-4">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Mes projets</h1>
        @if (Model.Projects.Count == 0)
        {
            <div class="empty-state">
                <icon name="kanban" />
                <p class="mb-0">Aucun projet pour l'instant. Créez-en un, ou demandez à un collègue de vous ajouter au sien.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var project in Model.Projects)
                {
                    <div class="col-md-6">
                        <partial name="_ProjectCard" model="project" />
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm" id="nouveau">
            <div class="card-body">
                <h2 class="h5 mb-3"><icon name="plus-lg" /> Nouveau projet</h2>
                <form method="post" asp-page-handler="Create" novalidate>
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" maxlength="80" placeholder="Ex. : TP Cloud" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="2" maxlength="300"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Créer le projet</button>
                </form>
                <p class="small text-body-secondary mt-3 mb-0">Vous en serez le propriétaire et pourrez inviter des membres depuis ses paramètres.</p>
            </div>
        </div>
    </div>
</div>
