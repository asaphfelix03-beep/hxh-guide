@page
@model SearchModel
@{
    ViewData["Title"] = "Recherche";
    var states = Enum.GetValues<TaskState>().Select(s => new SelectListItem(s.Label(), s.ToString()));
}

<h1 class="h3 mb-3">Rechercher une tâche</h1>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md">
            <div class="input-icon">
                <icon name="search" />
                <input asp-for="Q" type="search" class="form-control" placeholder="Titre, description ou #étiquette" aria-label="Texte recherché" autofocus />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select asp-for="State" asp-items="states" class="form-select" aria-label="Colonne">
                <option value="">Toutes les colonnes</option>
            </select>
        </div>
        <div class="col-6 col-md-auto">
            <div class="form-check mb-0">
                <input asp-for="Mine" class="form-check-input" />
                <label asp-for="Mine" class="form-check-label">Assignées à moi</label>
            </div>
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary w-100">Rechercher</button>
        </div>
    </div>
</form>

@if (Model.Searched)
{
    <p class="text-body-secondary small">@Model.Results.Count résultat(s)@(Model.Results.Count == 50 ? " (50 premiers)" : "")</p>
    @if (Model.Results.Count == 0)
    {
        <div class="empty-state">
            <icon name="search" />
            <p class="mb-0">Aucune tâche ne correspond à votre recherche.</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var task in Model.Results)
            {
                <a class="list-group-item list-group-item-action d-flex gap-3 align-items-center py-3 @(task.State == TaskState.Done ? "is-done" : "")" href="/Tasks/Edit/@task.Id">
                    <span class="state-dot state-@task.State.ToString().ToLowerInvariant()" title="@task.State.Label()"></span>
                    <span class="flex-grow-1 min-w-0">
                        <span class="d-block fw-semibold text-truncate task-title">@task.Title</span>
                        <span class="small text-body-secondary">@task.Project.Name · @task.State.Label()</span>
                        @foreach (var tag in task.TagList)
                        {
                            <tag-chip value="@tag" />
                        }
                    </span>
                    @if (task.DueDate is { } due)
                    {
                        <span class="due small @(task.IsOverdue(Model.Today) ? "due-late" : "")"><icon name="calendar-event" /> @due.ToString("d MMM")</span>
                    }
                    @if (task.Assignee is { } assignee)
                    {
                        <avatar user-id="@assignee.Id" name="@assignee.DisplayName" class="avatar-sm" />
                    }
                </a>
            }
        </div>
    }
}
