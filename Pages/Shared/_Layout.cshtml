@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · TaskFlow</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand bg-white border-bottom">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-page="/Index">
                <i class="bi bi-check2-square text-primary"></i> TaskFlow
            </a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/api/tasks"><i class="bi bi-braces"></i> API</a></li>
                <li class="nav-item"><a class="nav-link" href="/health"><i class="bi bi-heart-pulse"></i> Santé</a></li>
            </ul>
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle"></i> @message</div>
        }
        @RenderBody()
    </main>

    <footer class="border-top bg-white">
        <div class="container py-3 small text-muted d-flex flex-wrap gap-3">
            <span>TaskFlow v@(AppInfo.Version)</span>
            <span><i class="bi bi-box"></i> Conteneur <code>@Environment.MachineName</code></span>
            <span>.NET @Environment.Version</span>
            <span>@Env.EnvironmentName</span>
        </div>
    </footer>
</body>
</html>
