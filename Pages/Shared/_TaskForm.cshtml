@model TaskFlow.Pages.Tasks.TaskFormPage
@{
    var states = Enum.GetValues<TaskState>().Select(s => new SelectListItem(s.Label(), s.ToString()));
    var priorities = Enum.GetValues<Priority>().Select(p => new SelectListItem(p.Label(), p.ToString()));
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

<div class="mb-3">
    <label asp-for="Input.Title" class="form-label"></label>
    <input asp-for="Input.Title" class="form-control form-control-lg" maxlength="100" autofocus />
    <span asp-validation-for="Input.Title" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Input.Description" class="form-label"></label>
    <textarea asp-for="Input.Description" class="form-control" rows="4" maxlength="2000" placeholder="Détails, liens, critères de réussite…"></textarea>
    <span asp-validation-for="Input.Description" class="text-danger small"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-md-3">
        <label asp-for="Input.State" class="form-label"></label>
        <select asp-for="Input.State" asp-items="states" class="form-select"></select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="Input.Priority" class="form-label"></label>
        <select asp-for="Input.Priority" asp-items="priorities" class="form-select"></select>
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="Input.DueDate" class="form-label"></label>
        <input asp-for="Input.DueDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="Input.AssigneeId" class="form-label"></label>
        <select asp-for="Input.AssigneeId" asp-items="Model.MemberOptions" class="form-select">
            <option value="">Personne</option>
        </select>
        <span asp-validation-for="Input.AssigneeId" class="text-danger small"></span>
    </div>
</div>

<div>
    <label asp-for="Input.Tags" class="form-label"></label>
    <div class="input-icon">
        <icon name="tag" />
        <input asp-for="Input.Tags" class="form-control" maxlength="200" placeholder="docker, urgent, doc" aria-describedby="tags-help" />
    </div>
    <div id="tags-help" class="form-text">Séparées par des virgules, @TagList.MaxTags maximum.</div>
</div>
