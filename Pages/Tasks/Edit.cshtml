@page "{id:int}"
@model TaskFlow.Pages.Tasks.EditModel
@{
    ViewData["Title"] = Model.Item.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <nav aria-label="Fil d'Ariane" class="small mb-1">
            <a href="/Projects">Projets</a> / <a href="/Projects/Board/@Model.Project.Id">@Model.Project.Name</a> /
        </nav>
        <h1 class="h3 mb-3">Modifier la tâche</h1>

        <form method="post" class="card card-body shadow-sm" novalidate>
            <partial name="_TaskForm" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" href="/Projects/Board/@Model.Project.Id">Annuler</a>
                <button type="submit" class="btn btn-outline-danger ms-auto" asp-page-handler="Delete"
                        data-confirm="Supprimer définitivement cette tâche ?">
                    <icon name="trash" /> Supprimer
                </button>
            </div>
        </form>

        <p class="small text-body-secondary mt-3">
            Créée le @Model.Item.CreatedAt.ToString("d MMMM yyyy")@(Model.Item.CreatedBy is { } author ? $" par {author.DisplayName}" : "")
            @if (Model.Item.CompletedAt is { } completed)
            {
                <span>· terminée le @completed.ToString("d MMMM yyyy")</span>
            }
        </p>
    </div>
</div>
