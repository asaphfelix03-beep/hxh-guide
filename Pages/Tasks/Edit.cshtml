@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Modifier la tâche";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-3">Modifier la tâche</h1>
        <form method="post" class="card card-body shadow-sm">
            <partial name="_TaskForm" for="Input" />
            <div class="form-check mt-3">
                <input asp-for="Input.IsDone" class="form-check-input" />
                <label asp-for="Input.IsDone" class="form-check-label"></label>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn btn-outline-secondary" asp-page="/Index">Annuler</a>
            </div>
        </form>
    </div>
</div>
