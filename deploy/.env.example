# Copier en .env sur le serveur (user-data.sh le génère automatiquement).
# Nom de domaine : sslip.io transforme l'IP en nom (13.48.46.246 -> 13-48-46-246.sslip.io), ce qui permet un certificat HTTPS gratuit.
DOMAIN=13-48-46-246.sslip.io
IMAGE=asaph01/hxh-guide:1.0
# Mot de passe PostgreSQL : long et aléatoire (openssl rand -hex 24). Ne jamais le committer.
POSTGRES_PASSWORD=change-moi
# Comptes de démonstration (demo@guide.local / Demo1234) créés au premier démarrage.
SEED_DEMO=true
