# Caddy obtient et renouvelle automatiquement un certificat Let's Encrypt pour $DOMAIN,
# redirige HTTP -> HTTPS et compresse les réponses.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy app:8080
}
